# Database
DATABASE_URL=postgres://fitlog:fitlog@localhost:55432/fitlog?sslmode=disable

# Encryption key for OAuth tokens in DB
FITLOG_TOKEN_ENCRYPTION_KEY=

# Whoop OAuth 2.0 (бот делает flow сам)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/oauth/whoop/callback

# FatSecret OAuth 1.0. Consumer credentials are required; delegated access
# tokens are obtained by the bot and encrypted in DB. The optional access pair
# is only a migration fallback for an existing installation.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_SECRET=
# Your current maintenance calories; used for the 14-day deficit analysis.
NUTRITION_ESTIMATED_TDEE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# App
LOG_LEVEL=info
HTTP_ADDR=:8080
TZ_LOCATION=Europe/Moscow

# Obsidian articles. Point this at the folder whose Markdown files may be published.
# obsidian-git can keep the vault in sync; fitlog only reads this folder.
OBSIDIAN_ARTICLES_PATH=/absolute/path/to/obsidian-vault/Public
# Public origin used in Telegram article links. Falls back to WHOOP_REDIRECT_URI origin.
PUBLIC_BASE_URL=http://localhost:8080
