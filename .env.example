# Database
DATABASE_URL=postgres://fitlog:fitlog@localhost:55432/fitlog?sslmode=disable

# Encryption key for Whoop OAuth tokens in DB
FITLOG_TOKEN_ENCRYPTION_KEY=

# Whoop OAuth 2.0 (бот делает flow сам)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/oauth/whoop/callback

# FatSecret OAuth 1.0 — токены кладёшь руками, бот ими пользуется
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# App
LOG_LEVEL=info
HTTP_ADDR=:8080
TZ_LOCATION=Europe/Moscow
