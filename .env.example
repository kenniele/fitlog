# Database
DATABASE_URL=postgres://fitlog:fitlog@localhost:55432/fitlog?sslmode=disable

# Encryption key for OAuth tokens in DB
FITLOG_TOKEN_ENCRYPTION_KEY=

# Whoop OAuth 2.0 (бот делает flow сам)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/oauth/whoop/callback

# FatSecret OAuth 1.0. Consumer credentials are required; delegated access
# tokens are obtained by the bot and encrypted in DB. The optional access pair
# is only a migration fallback for an existing installation.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_SECRET=
# Your current maintenance calories; used for the 14-day deficit analysis.
NUTRITION_ESTIMATED_TDEE=

# Automatic provider refresh runs once at startup and then on this interval.
# Use 0s to disable it. A short correction window catches late provider updates.
FITLOG_PROVIDER_SYNC_INTERVAL=1h
FITLOG_PROVIDER_SYNC_LOOKBACK_DAYS=3
# WHOOP is synchronized automatically after OAuth. Persistent FatSecret diary
# storage additionally requires a separate entitlement/authorization.
FATSECRET_STORAGE_AUTHORIZED=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Optional: comma-separated channel IDs such as -1001234567890,-1009876543210.
# The bot must be an admin with permission to post messages in every channel.
TELEGRAM_WORKOUT_CHANNEL_IDS=
# Backward-compatible single channel setting. It is combined with the list.
TELEGRAM_WORKOUT_CHANNEL_ID=

# Optional FitLog Control Center. When the token is empty, the Telegram bot and
# provider callbacks keep working but /api/v1 returns dashboard_disabled.
# Use a long random value (for example: openssl rand -base64 32).
FITLOG_DASHBOARD_TOKEN=
# Defaults to the first TELEGRAM_ALLOWED_USER_IDS value so the dashboard and
# bot share the same workout history. Set only when the allowlist has several IDs.
FITLOG_DASHBOARD_OWNER_ID=

# App
LOG_LEVEL=info
HTTP_ADDR=:8080
TZ_LOCATION=Europe/Moscow

# Obsidian articles. Point this at the folder whose Markdown files may be published.
# obsidian-git can keep the vault in sync; fitlog only reads this folder.
OBSIDIAN_ARTICLES_PATH=/absolute/path/to/obsidian-vault/Public
# Public origin used in Telegram article links. Falls back to WHOOP_REDIRECT_URI origin.
PUBLIC_BASE_URL=http://localhost:8080
